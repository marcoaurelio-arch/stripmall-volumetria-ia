# ============================================================
# 🔐 DEV AUTH BYPASS — Solves OAuth 403 on localhost
# ============================================================
# The Manus OAuth server blocks localhost redirect URIs (403).
# These variables activate a /api/dev-login route that issues
# a valid JWT session cookie WITHOUT going through OAuth.
#
# How it works:
#   1. Set DEV_USER_ID to your Manus openId (OWNER_OPEN_ID above)
#   2. Set VITE_DEV_AUTH_ENABLED=true to show the "Dev Login" button
#   3. Start the server: pnpm dev
#   4. Visit http://localhost:3000/api/dev-login
#      → Session cookie is set → you are logged in as the dev user
#   5. To log out: http://localhost:3000/api/dev-logout
#
# ⚠️  SECURITY: This bypass is ONLY active when NODE_ENV=development.
#     It is completely disabled in production builds.
# ============================================================
DEV_USER_ID=Avwxuxkgnjw3RziGvghpDz
DEV_USER_NAME=Marco Aurélio Simões
DEV_USER_EMAIL=marco@nexamalls.com.br
VITE_DEV_AUTH_ENABLED=true
